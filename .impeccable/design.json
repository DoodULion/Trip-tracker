  "narrative": {
    "northStar": "Station Line",
    "overview": "A trip is a rail line. Each day is a numbered station, each category a line color, each budget a sign panel. Surfaces are white enamel signs with heavy ink keylines set on a warm light-grey ground; the single orange line is the shell around everything (top band, primary action, the day line). The look is made for a sunlit street and one-handed use: large numerals, hard edges, full-strength color, nothing translucent or soft.\n\nThe system refuses the grey-cards-plus-one-accent finance default and the cherry-blossom-and-torii Japan costume. Japan is present only in the transit-signage grammar and in two authored SVG motifs (seigaiha wave scales on the trips-list band, a bullet train riding each trip's route bar). Dark mode is an enamel-black ground with the same line colors.",
    "keyCharacteristics": [
      "Heavy ink keylines (3px panels, 2px controls) instead of shadows.",
      "Category = line color + roundel code; color is never the only signal because the name and code always sit beside it.",
      "One typeface, tabular numerals, no display face.",
      "The one number you need today is set large (44px), like a sign band.",
      "Running totals right-aligned and tight to the margin."
    ],
    "rules": [
      {
        "name": "The Red Means Over Rule",
        "body": "Red marks over-limit, missing data, errors and destruction only; it is never decoration and never a category.",
        "section": "colors"
      },
      {
        "name": "The Fixed Lines Rule",
        "body": "A category keeps its line color on every screen, every trip, in both schemes. Do not recolor categories per context.",
        "section": "colors"
      },
      {
        "name": "The Ink On Orange Rule",
        "body": "Text on the orange shell is ink, not white.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every figure aligns on tabular numerals; amounts right-align.",
        "section": "typography"
      },
      {
        "name": "The Sixteen Rule",
        "body": "Inputs never fall below 16px.",
        "section": "typography"
      },
      {
        "name": "The Keyline Not Shadow Rule",
        "body": "Separation is a heavy ink line, never a blur.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** separate surfaces with a 3px ink keyline and 10px corners.",
      "**Do** code every category with its fixed line color and roundel letter, beside its name.",
      "**Do** put ink text on the orange shell and use orange for the primary action only once per view.",
      "**Do** keep tap targets at 44px or more and inputs at 16px or more.",
      "**Do** show blanks, not zeros, and flag missing data with a red border plus text.",
      "**Do** honor `prefers-reduced-motion`; the only motion is the route fill and train ride (0.8s) and the toast fade.",
      "**Do** draw new imagery as authored SVG in the 2px line vocabulary."
    ],
    "donts": [
      "**Don't** use red for anything but over-limit, missing data, errors or destruction.",
      "**Don't** introduce a display face, shadows, gradients as fills, or translucent glass.",
      "**Don't** put cherry blossom, torii or Fuji costume on any surface.",
      "**Don't** recolor a category, or let color be the only over/under or error signal.",
      "**Don't** add a third column to the category grid."
    ]
  }
}